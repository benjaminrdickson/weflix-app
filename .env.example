# Rails secret key — generate with: bundle exec rails secret
SECRET_KEY_BASE=

# TMDB API key — get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# PostgreSQL connection string (used in production)
# Format: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Allowed CORS origin for the frontend (React Native / Expo dev server or production URL)
# Local Expo: leave blank (localhost:8081 is always allowed)
# Production: https://your-app.onrender.com
FRONTEND_URL=

# AWS S3 — for profile picture uploads via Active Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET=
